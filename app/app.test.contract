fresh
epoch now

test "a new account starts empty and signed in"
  expect text "auth-error" == ""
  type "email" "first@example.com"
  type "password" "correct horse battery staple"
  tap "signup"
  clock data
  expect tree has "empty-add"
  expect tree has "tab-inbox"

test "an overused word gets a target to use instead, and both are kept"
  type "email" "words@example.com"
  type "password" "correct horse battery staple"
  tap "signup"
  clock data
  tap "add-term"
  clock settle
  type "add-text" "Interesting"
  type "add-meaning" "arousing curiosity"
  tap "add-save"
  clock data
  expect tree has "term-interesting"
  tap "add-term"
  clock settle
  type "add-text" "compelling"
  tap "add-overused"
  tap "add-target"
  tap "add-save"
  clock data
  tap "term-interesting"
  clock data
  clock settle
  expect text "detail-title" == "Interesting"
  expect text "detail-meaning" == "arousing curiosity"
  tap "add-link"
  clock settle
  type "link-to" "compelling"
  type "link-use-when" "a point that holds attention"
  tap "link-save"
  clock data
  expect text "move-0" == "compelling"
  reload
  clock data
  expect text "detail-title" == "Interesting"
  expect text "move-0" == "compelling"

test "a word that is already there is refused, and filters narrow the list"
  type "email" "dupes@example.com"
  type "password" "correct horse battery staple"
  tap "signup"
  clock data
  tap "add-term"
  clock settle
  type "add-text" "basically"
  tap "add-save"
  clock data
  tap "add-term"
  clock settle
  type "add-text" "Basically "
  tap "add-save"
  clock data
  expect text "add-hint" == "That word is already in your library."
  tap "add-cancel"
  clock settle
  tap "filter-target"
  expect tree missing "term-basically"
  tap "filter-overused"
  expect tree has "term-basically"

test "the wrong password is refused"
  type "email" "nobody@example.com"
  type "password" "not the right one"
  tap "login"
  clock data
  expect text "auth-error" == "That email and password don’t match."

test "progress starts empty with its next step"
  type "email" "progress@example.com"
  type "password" "correct horse battery staple"
  tap "signup"
  clock data
  tap "tab-progress"
  clock settle
  expect tree missing "stat-0"

test "the keyboard reaches every command"
  type "email" "keys@example.com"
  type "password" "correct horse battery staple"
  tap "signup"
  clock data
  type "app" key "Meta+n"
  clock settle
  expect tree has "add-text"
  type "add-text" "vivid"
  tap "add-overused"
  tap "add-target"
  type "add-text" key "Meta+s"
  clock data
  expect tree has "term-vivid"
  expect tree missing "add-text"
  type "app" key "Meta+n"
  clock settle
  type "add-text" key "Escape"
  clock settle
  expect tree missing "add-text"
  type "app" key "Meta+2"
  clock settle
  expect state nav.tab == "progress"
  type "app" key "Meta+n"
  clock settle
  expect state nav.tab == "library"
  expect tree has "add-text"
  type "add-text" key "Escape"
  clock settle
  type "app" key "Meta+3"
  clock settle
  expect state nav.tab == "inbox"
  type "app" key "Meta+f"
  clock settle
  expect state nav.tab == "library"
  tap "term-vivid"
  clock data
  clock settle
  type "app" key "Meta+e"
  clock settle
  expect tree has "edit-text"
  type "edit-text" key "Escape"
  clock settle
  expect tree missing "edit-text"
