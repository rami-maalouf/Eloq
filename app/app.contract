// Eloq: the words you overuse, the words you want to use, and the moves between them.
// app.ts answers every read from this device's Snapback partition and syncs it; a write is
// kept here at once and sent by the next sync, so everything works offline.
use EmptyState from "exact:content"
use typingStatus, setTypingTable, setUnderlines, openAccessibilitySettings, typingmove, typingcapture, TypingStatus, TypingMove, TypingCapture from "@eloq/typing"

routes nav
  tab library "/"
    term "/term/:id"
    addTerm "/add"
    editTerm "/term/:id/edit"
    addLink "/term/:id/link"
  tab inbox "/inbox"
  tab progress "/progress"

shape Clock
  epochAtZero: number
shape Term
  id: string
  text: string
  normalized: string
  overused: bool
  target: bool
  meaning: string
  nuance: string
  whenNotToUse: string
  example: string
  notes: string
  forms: string[]
  contexts: string[]
  tags: string[]
  provenance: string
  pending: bool
shape Link
  id: string
  from: string
  to: string
  fromText: string
  toText: string
  status: string
  origin: string
  confidence: number
  rationale: string
  useWhen: string
  caution: string
  example: string
  pending: bool
shape TermStat
  id: string
  text: string
  overused: bool
  said: number
  typed: number
  swapped: number
  targetUsed: number
  per1000: number
shape Week
  start: string
  spokenWords: number
  overused: number
  targets: number
shape Library
  principal: string
  online: bool
  sending: number
  terms: Term[]
  links: Link[]
  stats: TermStat[]
  weeks: Week[]
  spokenWords: number
  typing: string
shape Reply
  ok: bool
  id: string
  kept: bool

fn termOf(terms: Term[], id: string): Term[] = terms.filter(t => t.id == id)
fn textOf(terms: Term[], id: string): string = match first(terms.filter(t => t.id == id)) { case some(t) => t.text, case none => "" }
fn matches(t: Term, q: string): bool = q.trim() == "" or t.normalized.includes(q.trim().toLowerCase()) or t.meaning.toLowerCase().includes(q.trim().toLowerCase())
fn shownBy(t: Term, filter: string): bool = filter == "all" or (filter == "overused" and t.overused) or (filter == "target" and t.target)
fn movesFrom(links: Link[], id: string): Link[] = links.filter(l => l.from == id and l.status == "accepted")
fn movesTo(links: Link[], id: string): Link[] = links.filter(l => l.to == id and l.status == "accepted")
fn role(t: Term): string = t.overused and t.target ? "Overused and target" : t.overused ? "Overused" : "Target"
fn subtitle(t: Term, links: Link[]): string = t.overused and movesFrom(links, t.id).length > 0 ? `${role(t)} · try ${movesFrom(links, t.id).map(l => l.toText).join(", ")}` : t.meaning != "" ? `${role(t)} · ${t.meaning}` : role(t)
fn plural(n: number, one: string, many: string): string = `${n} ${n == 1 ? one : many}`

component App
  state email = ""
  state password = ""
  state query = ""
  state filter = "all" persist
  state sampledAt = 0
  // the add sheet's draft
  state draftText = ""
  state draftOverused = true
  state draftTarget = false
  state draftMeaning = ""
  state draftExample = ""
  // the link sheet's draft
  state linkTo = ""
  state linkUseWhen = ""
  state refusal = ""
  state aimed = ""
  // the typing table last handed to the overlay
  state typingSent = ""
  // thin lines under your words in other apps
  state underlines = true persist
  resource time = exactTime() as shape Clock
  resource lib = library() with time.epochAtZero + sampledAt as shape Library else empty()
  resource typing = typingStatus() as shape TypingStatus else empty()
  mutation signed as shape Reply refreshes lib
  mutation added as shape Reply queue refreshes lib then afterAdd
  mutation edited as shape Reply queue refreshes lib then afterEdit
  mutation removed as shape Reply queue refreshes lib
  mutation linked as shape Reply queue refreshes lib then afterLink
  mutation reviewed as shape Reply queue refreshes lib
  mutation typingSet as shape TypingStatus
  mutation underlinesSet as shape TypingStatus
  mutation typed as shape Reply queue
  derive signedIn = lib.principal != ""
  derive writing = pending(signed) or pending(added) or pending(edited) or pending(removed) or pending(linked) or pending(reviewed)
  derive shown = lib.terms.filter(t => shownBy(t, filter) and matches(t, query))
  derive suggestions = lib.links.filter(l => l.status == "suggested")
  derive targets = lib.terms.filter(t => t.target)
  derive selected = match stack(nav).filter(e => e.name == "term" or e.name == "editTerm" or e.name == "addLink").at(-1) { case some(e) => e.params.id, case none => "" }
  derive authError = match failure(signed) { case some(f) => (f.code == "E_AUTH" ? "That email and password don’t match." : f.reason != "" ? f.reason : f.message), case none => "" }
  derive status = pending(lib) and lib.principal == "" ? "" : lib.sending > 0 ? `${plural(lib.sending, "change", "changes")} waiting to sync` : lib.online ? "Synced" : "Offline: changes sync when you’re back online"
  derive addHint = draftText.trim() == "" ? "Enter a word or phrase." : not draftOverused and not draftTarget ? "Mark it overused, a target, or both." : ""
  task live mount
    every(5000, tick)

  action tick
    if not writing
      sampledAt = performanceNow()
      refresh lib
    if lib.typing != "" and lib.typing != typingSent
      typingSent = lib.typing
      send typingSet = setTypingTable(table=lib.typing)
    if typing.available and typing.underlines != underlines and not pending(underlinesSet)
      send underlinesSet = setUnderlines(on=underlines)
  // the overlay saw an overused word in another app, swapped it, or it was kept
  action moved(m: TypingMove)
    send typed = recordTyping(m.kind, m.term, m.app, time.epochAtZero + performanceNow())
  // the shortcut in another app, or the services menu: a word to keep, or one to look at here
  action captured(c: TypingCapture)
    if c.kind == "add"
      send added = addTerm(c.text, c.overused, c.target, "", "", time.epochAtZero + performanceNow())
    else
      focus()
      match first(lib.terms.filter(t => t.normalized == c.text.trim().toLowerCase()))
        case some(t)
          nav = go(select(nav, "library"), path("term", t.id))
        case none
          draftText = c.text
          draftOverused = true
          draftTarget = false
          draftMeaning = ""
          draftExample = ""
          refusal = ""
          nav = push(select(nav, "library"), "/add")
  action allowTyping
    openAccessibilitySettings()
  action setUnderlined(on: bool)
    underlines = on
    send underlinesSet = setUnderlines(on=on)
  action show
    focus()
  action showAdd
    focus()
    draftText = ""
    draftOverused = true
    draftTarget = false
    draftMeaning = ""
    draftExample = ""
    refusal = ""
    nav = push(select(nav, "library"), "/add")
  action find
    nav = select(nav, "library")
    focus("search")
  action editEmail(v: string)
    email = v
  action editPassword(v: string)
    password = v
  action signup
    send signed = signup(email.trim(), password, time.epochAtZero + performanceNow())
  action login
    send signed = login(email.trim(), password, time.epochAtZero + performanceNow())
  action logout
    send signed = logout(time.epochAtZero + performanceNow())
  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = top(nav).name == "term" and url.startsWith("/term/") and not url.endsWith("/edit") and not url.endsWith("/link") ? replace(nav, url) : go(nav, url)
  action back
    nav = back(nav)
  action search(v: string)
    query = v
  action choose(f: string)
    filter = f

  action openAdd
    draftText = query.trim()
    draftOverused = filter != "target"
    draftTarget = filter == "target"
    draftMeaning = ""
    draftExample = ""
    refusal = ""
    nav = push(select(nav, "library"), "/add")
  action editDraftText(v: string)
    draftText = v
  action setDraftOverused(on: bool)
    draftOverused = on
  action setDraftTarget(on: bool)
    draftTarget = on
  action editDraftMeaning(v: string)
    draftMeaning = v
  action editDraftExample(v: string)
    draftExample = v
  action add
    if addHint == "" and not pending(added)
      send added = addTerm(draftText, draftOverused, draftTarget, draftMeaning, draftExample, time.epochAtZero + performanceNow())
  action afterAdd
    refusal = ""
    if top(nav).name == "addTerm"
      nav = back(nav)

  action save(id: string, word: string, overused: bool, target: bool, meaning: string, nuance: string, whenNotToUse: string, example: string, notes: string)
    send edited = editTerm(id, word, overused, target, meaning, nuance, whenNotToUse, example, notes, time.epochAtZero + performanceNow())
  action openEdit(id: string)
    nav = push(nav, path("editTerm", id))
  action afterEdit
    if top(nav).name == "editTerm"
      nav = back(nav)

  action askRemove(id: string)
    aimed = id
    showModal("remove")
  action remove(id: string)
    send removed = removeTerm(id, time.epochAtZero + performanceNow())
    if selected == id
      nav = back(nav)

  action openLink(id: string)
    linkTo = ""
    linkUseWhen = ""
    nav = push(nav, path("addLink", id))
  action chooseTarget(v: string)
    linkTo = v
  action editLinkUseWhen(v: string)
    linkUseWhen = v
  action addLink(from: string)
    if linkTo != "" and not pending(linked)
      send linked = addLink(from, linkTo, linkUseWhen, "", time.epochAtZero + performanceNow())
  action afterLink
    if top(nav).name == "addLink"
      nav = back(nav)

  action accept(id: string)
    send reviewed = setLinkStatus(id, "accepted", time.epochAtZero + performanceNow())
  action dismiss(id: string)
    send reviewed = setLinkStatus(id, "dismissed", time.epochAtZero + performanceNow())
  action unlink(id: string)
    send reviewed = removeLink(id, time.epochAtZero + performanceNow())

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow typingmove=moved typingcapture=captured testId="app" width="100%" height="100%"
      display="flex" flex-direction="column"
      if not signedIn and pending(lib)
        column flex=1 min-height=0
      else if not signedIn
        column flex=1 min-height=0 align-items="center"
          column flex=1 min-height=0 width="100%" max-width="26.25rem"
            header display="flex" flex-direction="column" align-items="center" gap=4 padding="48px 16px 8px"
              h1 "Eloq"
              text "Trade the words you overuse for the words you mean." color="-exact-secondary-label" text-align="center"
            list id="sign-in" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                header
                  text "Sign in to keep your words on all your devices"
                row
                  input value=email input=editEmail type="email" placeholder="Email" aria-label="Email"
                    autocomplete="email" testId="email" flex=1 min-width=0
                row
                  input value=password input=editPassword type="password" placeholder="Password" aria-label="Password"
                    submit=login testId="password" flex=1 min-width=0
                footer
                  text authError color="-exact-system-red" testId="auth-error"
              section
                button press=login disabled=(email.trim() == "" or password == "" or pending(signed)) testId="login"
                  text "Sign In"
                button press=signup disabled=(email.trim() == "" or password == "" or pending(signed)) testId="signup"
                  text "Create Account"
      else
        column flex=1 min-height=0 position="relative"
          for t in nav.tabs key=t.name
            column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
              for e in t.stack key=e.id
                if e.name == "library"
                  column navigationKey=`${e.id}` navigationScroll="terms" position="absolute" inset=0
                    display="flex" flex-direction="column"
                    header display="flex" flex-wrap="wrap" align-items="center" gap=8 padding="8px 16px"
                      text "Library" role="heading" aria-level=1 flex=1
                      button press=openAdd aria-label="Add Word" testId="add-term"
                        image "symbol:add"
                      input id="search" type="search" value=query input=search placeholder="Search" aria-label="Search Words"
                        testId="search" width="100%"
                    row role="radiogroup" aria-label="Show" padding="0 16px 8px" testId="filter"
                      button role="radio" aria-checked=(filter == "all") press=choose("all") testId="filter-all" flex=1
                        text "All"
                      button role="radio" aria-checked=(filter == "overused") press=choose("overused") testId="filter-overused" flex=1
                        text "Overused"
                      button role="radio" aria-checked=(filter == "target") press=choose("target") testId="filter-target" flex=1
                        text "Targets"
                    if failed(lib) and lib.principal == ""
                      EmptyState(symbol="symbol:alert", title="Can’t Open Your Library", message="Check your connection; your words sync once this device has them.")
                        button press=tick testId="retry"
                          text "Try Again"
                    else if lib.terms.length == 0 and not pending(lib)
                      EmptyState(symbol="symbol:book", title="No Words Yet", message="Add a word you overuse, or one you want to use more.")
                        button press=openAdd testId="empty-add"
                          text "Add Word"
                    else if shown.length == 0 and not pending(lib)
                      EmptyState(symbol="symbol:search", title=(query.trim() == "" ? "Nothing Here Yet" : `No Results for “${query.trim()}”`), message="Try another search or filter.")
                    else
                      list id="terms" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                        section
                          for w in shown key=w.id
                            link href=path("term", w.id) delete=remove(w.id) testId=`term-${w.normalized}`
                              column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                                text w.text line-clamp=1
                                text subtitle(w, lib.links) font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1
                              image "symbol:forward-chevron"
                          footer
                            text `${plural(shown.length, "word", "words")}${status == "" ? "" : ` · ${status}`}` testId="status"
                if e.name == "term"
                  column navigationKey=`${e.id}` navigationScroll="term-detail" position="absolute" inset=0
                    display="flex" flex-direction="column"
                    header display="flex" align-items="center" gap=8 padding="8px 16px"
                      text (textOf(lib.terms, e.params.id) == "" ? "Not Found" : textOf(lib.terms, e.params.id)) role="heading" aria-level=2 flex=1 testId="detail-title"
                      if termOf(lib.terms, e.params.id).length > 0
                        button press=openEdit(e.params.id) aria-label="Edit Word" aria-keyshortcuts="Meta+E Control+E" testId="edit-term"
                          text "Edit"
                    if termOf(lib.terms, e.params.id).length > 0
                      list id="term-detail" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                        for w in termOf(lib.terms, e.params.id) key=w.id
                          TermSections(term=w, from=movesFrom(lib.links, w.id), to=movesTo(lib.links, w.id),
                            openLink=openLink(w.id), unlink=unlink, askRemove=askRemove(w.id))
                    else if not pending(lib)
                      EmptyState(symbol="symbol:alert", title="No Such Word", message="It may have been deleted on another device.")
                        button press=back buttonStyle="filled" testId="missing-back"
                          text "Back to Library"
                if e.name == "addTerm"
                  column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="add-form" position="absolute" inset=0
                    header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
                      button id="back" press=back aria-label="Cancel" aria-keyshortcuts="Escape" testId="add-cancel"
                        text "Cancel"
                      text "New Word" role="heading"
                      button press=add buttonStyle="bordered-prominent" aria-label="Save" aria-keyshortcuts="Meta+S Control+S" testId="add-save"
                        disabled=(addHint != "" or pending(added))
                        text "Save"
                    list id="add-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 width="28rem" max-width="100%"
                      section
                        row
                          input value=draftText input=editDraftText placeholder="Word or phrase" aria-label="Word or phrase"
                            autofocus=true submit=add autocapitalize="none" testId="add-text" flex=1 min-width=0
                        row
                          text "I overuse it"
                          input type="checkbox" switch checked=draftOverused change=setDraftOverused aria-label="I overuse it" testId="add-overused"
                        row
                          text "I want to use it"
                          input type="checkbox" switch checked=draftTarget change=setDraftTarget aria-label="I want to use it" testId="add-target"
                        footer
                          text (match failure(added) { case some(f) => (f.code == "TERM_EXISTS" ? "That word is already in your library." : f.message), case none => addHint }) testId="add-hint"
                      section
                        header
                          text "Meaning"
                        row padding-top=8 padding-bottom=8
                          textarea value=draftMeaning input=editDraftMeaning placeholder="Optional" aria-label="Meaning"
                            rows=3 testId="add-meaning" flex=1 min-width=0
                      section
                        header
                          text "Example"
                        row padding-top=8 padding-bottom=8
                          textarea value=draftExample input=editDraftExample placeholder="Optional" aria-label="Example"
                            rows=3 testId="add-example" flex=1 min-width=0
                if e.name == "editTerm"
                  for w in termOf(lib.terms, e.params.id) key=w.id
                    EditTerm(entry=e.id, term=w, cancel=back, save=save, busy=pending(edited))
                if e.name == "addLink"
                  column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="link-form" position="absolute" inset=0
                    header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
                      button id="back" press=back aria-label="Cancel" aria-keyshortcuts="Escape" testId="link-cancel"
                        text "Cancel"
                      text `Instead of “${textOf(lib.terms, e.params.id)}”` role="heading"
                      button press=addLink(e.params.id) buttonStyle="bordered-prominent" aria-label="Save" aria-keyshortcuts="Meta+S Control+S" testId="link-save"
                        disabled=(linkTo == "" or pending(linked))
                        text "Save"
                    list id="link-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 width="28rem" max-width="100%"
                      section
                        row
                          text "Use"
                          select value=linkTo change=chooseTarget aria-label="Target word" testId="link-to"
                            option "Choose a word" value=""
                            for w in targets.filter(x => x.id != e.params.id) key=w.id
                              option w.text value=w.normalized
                        footer
                          text (match failure(linked) { case some(f) => (f.code == "LINK_EXISTS" ? "Those two words are already linked." : f.message), case none => (targets.length == 0 ? "Mark a word as a target first." : "") }) testId="link-hint"
                      section
                        header
                          text "Use it when"
                        row padding-top=8 padding-bottom=8
                          textarea value=linkUseWhen input=editLinkUseWhen placeholder="Optional" aria-label="Use it when"
                            rows=3 testId="link-use-when" flex=1 min-width=0
                if e.name == "progress"
                  column navigationKey=`${e.id}` navigationScroll="progress-list" position="absolute" inset=0
                    display="flex" flex-direction="column"
                    header display="flex" align-items="center" padding="8px 16px"
                      text "Progress" role="heading" aria-level=1 flex=1
                    if typing.available
                      row padding="0 16px 8px" gap=8 align-items="center" testId="typing-status"
                        text (typing.running ? "Typing in other apps: on" : typing.trusted ? "Typing in other apps: starting" : "Typing in other apps needs Accessibility permission") flex=1 color="-exact-secondary-label"
                        if not typing.trusted
                          button press=allowTyping buttonStyle="bordered" testId="allow-typing"
                            text "Allow…"
                      if typing.trusted
                        row padding="0 16px 8px" gap=8 align-items="center"
                          column flex=1 min-width=0 gap=2
                            text "Underline my words in other apps"
                            text "Amber dots for words you overuse, a green line for targets you used. Control-Option-Command-L adds the selected word." font="-exact-footnote" color="-exact-secondary-label"
                          input type="checkbox" switch checked=underlines change=setUnderlined aria-label="Underline my words in other apps" testId="underlines"
                    if lib.weeks.length == 0
                      EmptyState(symbol="symbol:chart", title="Nothing Counted Yet", message="Your agents count your overused and target words in what you say (record_transcript); they appear here by week.")
                    else
                      list id="progress-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                        section
                          header
                            text "This week"
                          if lib.stats.filter(r => r.overused).length == 0
                            row
                              text "No overused words counted this week." color="-exact-secondary-label"
                          for r, i in lib.stats.filter(x => x.overused) key=r.id
                            row testId=`stat-${i}`
                              column flex=1 min-width=0 gap=2
                                text r.text
                                text (r.swapped > 0 ? `swapped ${plural(r.swapped, "time", "times")}` : r.typed > 0 ? `typed ${plural(r.typed, "time", "times")}` : `said ${plural(r.said, "time", "times")}`) font="-exact-footnote" color="-exact-secondary-label"
                              text `${r.said + r.typed}` font-variant-numeric="tabular-nums" testId=`stat-count-${i}`
                          footer
                            text (lib.spokenWords > 0 ? `${plural(lib.spokenWords, "word", "words")} of speech counted this week` : "")
                        if lib.stats.filter(r => r.targetUsed > 0).length > 0
                          section
                            header
                              text "Targets you used"
                            for r in lib.stats.filter(x => x.targetUsed > 0) key=r.id
                              row
                                text r.text flex=1
                                text `${r.targetUsed}` font-variant-numeric="tabular-nums"
                        section
                          header
                            text "By week"
                          for w in lib.weeks key=w.start
                            row
                              text `Week of ${w.start}` flex=1
                              text `${w.overused} overused · ${plural(w.targets, "target", "targets")}` font-variant-numeric="tabular-nums" color="-exact-secondary-label"
                if e.name == "inbox"
                  column navigationKey=`${e.id}` navigationScroll="inbox-list" position="absolute" inset=0
                    display="flex" flex-direction="column"
                    header display="flex" align-items="center" padding="8px 16px"
                      text "Inbox" role="heading" aria-level=1 flex=1
                    if suggestions.length == 0
                      EmptyState(symbol="symbol:sparkles", title="Nothing to Review", message="Suggested moves from Claude and your agents appear here.")
                    else
                      list id="inbox-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                        for s, i in suggestions key=s.id
                          section
                            row
                              column flex=1 min-width=0 gap=2
                                text `${s.fromText} → ${s.toText}` testId=`suggestion-${i}`
                                if s.rationale != ""
                                  text s.rationale font="-exact-subheadline" color="-exact-secondary-label"
                                if s.useWhen != ""
                                  text `Use when: ${s.useWhen}` font="-exact-footnote" color="-exact-secondary-label"
                                if s.caution != ""
                                  text `Careful: ${s.caution}` font="-exact-footnote" color="-exact-secondary-label"
                            row gap=8
                              button press=accept(s.id) buttonStyle="filled" disabled=pending(reviewed) testId=`accept-${i}` flex=1
                                text "Accept"
                              button press=dismiss(s.id) buttonStyle="bordered" disabled=pending(reviewed) testId=`dismiss-${i}` flex=1
                                text "Dismiss"
      // always in the tree, so every host finds the tabs' routes; hidden until an account is signed in
      row role="tablist" testId="tabs" display=(signedIn ? "flex" : "none")
        button role="tab" aria-controls="panel-library" aria-selected=(nav.tab == "library") press=pick("library")
          aria-keyshortcuts="Meta+1 Control+1" testId="tab-library" flex=1
          image "symbol:book"
          text "Library"
        button role="tab" aria-controls="panel-progress" aria-selected=(nav.tab == "progress") press=pick("progress")
          aria-keyshortcuts="Meta+2 Control+2" testId="tab-progress" flex=1
          image "symbol:chart"
          text "Progress"
        button role="tab" aria-controls="panel-inbox" aria-selected=(nav.tab == "inbox") press=pick("inbox")
          aria-keyshortcuts="Meta+3 Control+3" testId="tab-inbox" flex=1
          image "symbol:sparkles"
          text "Inbox"
          if suggestions.length > 0
            row background-color="-exact-system-red" border-radius=12
              text `${suggestions.length}` font-variant-numeric="tabular-nums"
      // commands that work on every tab. a button inside a tab's panel hears its chord only while
      // that tab shows, so these stand outside the panels: on the mac each is a menu bar item with
      // its chord, and elsewhere a button a screen reader finds. they take no room and no clicks.
      if signedIn
        row position="absolute" width="0.0625rem" height="0.0625rem" overflow="hidden" opacity=0 pointer-events="none"
          button press=openAdd aria-label="New Word" aria-keyshortcuts="Meta+N Control+N" testId="command-new"
            text "New Word"
          button press=find aria-label="Find a Word" aria-keyshortcuts="Meta+F Control+F" testId="command-find"
            text "Find a Word"
      if typing.available
        button -exact-menu="status" popovertarget="status-menu" aria-label="Eloq" testId="status-item"
          image "symbol:book"
        column id="status-menu" popover="auto" role="menu" aria-label="Eloq"
          button press=show popovertarget="status-menu" popovertargetaction="hide" testId="status-open"
            text "Open Eloq"
          button press=showAdd popovertarget="status-menu" popovertargetaction="hide" testId="status-add"
            text "New Word…"
      dialog id="remove" role="alertdialog" aria-label=`Delete “${textOf(lib.terms, aimed)}”?`
        text "Its links go with it. This can’t be undone."
        button press=remove(aimed) destructive=true commandfor="remove" command="close" testId="remove-confirm"
          text "Delete"
        button commandfor="remove" command="close" testId="remove-cancel"
          text "Cancel"

// one word: what it means, how to use it, and where to move from or to it
component TermSections
  props
    term: Term
    from: Link[]
    to: Link[]
    openLink: action
    unlink: action
    askRemove: action
  view
    section
      row
        text "Overused"
        text (term.overused ? "Yes" : "No") testId="detail-overused"
      row
        text "Target"
        text (term.target ? "Yes" : "No") testId="detail-target"
    if term.meaning != ""
      section
        header
          text "Meaning"
        row padding-top=10 padding-bottom=10
          text term.meaning flex=1 min-width=0 testId="detail-meaning"
    if term.nuance != ""
      section
        header
          text "Nuance"
        row padding-top=10 padding-bottom=10
          text term.nuance flex=1 min-width=0
    if term.whenNotToUse != ""
      section
        header
          text "When not to use it"
        row padding-top=10 padding-bottom=10
          text term.whenNotToUse flex=1 min-width=0
    if term.example != ""
      section
        header
          text "Example"
        row padding-top=10 padding-bottom=10
          text term.example flex=1 min-width=0 font-style="italic"
    if term.overused
      section
        header
          text "Use instead"
        for l, i in from key=l.id
          row delete=unlink(l.id)
            column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
              text l.toText testId=`move-${i}`
              if l.useWhen != ""
                text l.useWhen font="-exact-subheadline" color="-exact-secondary-label"
              if l.caution != ""
                text `Careful: ${l.caution}` font="-exact-footnote" color="-exact-secondary-label"
        button press=openLink testId="add-link"
          text "Add a Word to Use Instead"
    if to.length > 0
      section
        header
          text "Use it instead of"
        for l in to key=l.id
          row
            text l.fromText
    if term.notes != ""
      section
        header
          text "Notes"
        row padding-top=10 padding-bottom=10
          text term.notes flex=1 min-width=0
    section
      button press=askRemove destructive=true testId="delete-term"
        text "Delete Word"

// the edit sheet: its fields start from the word it opened on
component EditTerm
  props
    entry: number
    term: Term
    cancel: action
    save: action
    busy: bool
  state word = term.text
  state overused = term.overused
  state target = term.target
  state meaning = term.meaning
  state nuance = term.nuance
  state whenNotToUse = term.whenNotToUse
  state example = term.example
  state notes = term.notes
  action editWord(v: string)
    word = v
  action setOverused(on: bool)
    overused = on
  action setTarget(on: bool)
    target = on
  action editMeaning(v: string)
    meaning = v
  action editNuance(v: string)
    nuance = v
  action editWhen(v: string)
    whenNotToUse = v
  action editExample(v: string)
    example = v
  action editNotes(v: string)
    notes = v
  action submit
    if word.trim() != "" and (overused or target) and not busy
      save(term.id, word, overused, target, meaning, nuance, whenNotToUse, example, notes)
  view
    column navigationKey=`${entry}` navigationPresentation="modal" navigationScroll="edit-form" position="absolute" inset=0
      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
        button id="back" press=cancel aria-label="Cancel" aria-keyshortcuts="Escape" testId="edit-cancel"
          text "Cancel"
        text "Edit Word" role="heading"
        button press=submit buttonStyle="bordered-prominent" aria-label="Save" aria-keyshortcuts="Meta+S Control+S" testId="edit-save"
          disabled=(word.trim() == "" or not (overused or target) or busy)
          text "Save"
      list id="edit-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 width="28rem" max-width="100%"
        section
          row
            input value=word input=editWord aria-label="Word or phrase" autocapitalize="none" testId="edit-text" flex=1 min-width=0
          row
            text "I overuse it"
            input type="checkbox" switch checked=overused change=setOverused aria-label="I overuse it" testId="edit-overused"
          row
            text "I want to use it"
            input type="checkbox" switch checked=target change=setTarget aria-label="I want to use it" testId="edit-target"
        section
          header
            text "Meaning"
          row padding-top=8 padding-bottom=8
            textarea value=meaning input=editMeaning aria-label="Meaning" rows=3 testId="edit-meaning" flex=1 min-width=0
        section
          header
            text "Nuance"
          row padding-top=8 padding-bottom=8
            textarea value=nuance input=editNuance aria-label="Nuance" rows=3 flex=1 min-width=0
        section
          header
            text "When not to use it"
          row padding-top=8 padding-bottom=8
            textarea value=whenNotToUse input=editWhen aria-label="When not to use it" rows=3 flex=1 min-width=0
        section
          header
            text "Example"
          row padding-top=8 padding-bottom=8
            textarea value=example input=editExample aria-label="Example" rows=3 flex=1 min-width=0
        section
          header
            text "Notes"
          row padding-top=8 padding-bottom=8
            textarea value=notes input=editNotes aria-label="Notes" rows=3 flex=1 min-width=0
