{
  "kind": "interface",
  "name": "@eloq/typing",
  "version": "1.0.0",
  "start": "load",
  "shapes": {
    "TypingStatus": {
      "available": "bool",
      "trusted": "bool",
      "running": "bool",
      "words": "number",
      "underlines": "bool"
    },
    "TypingMove": {
      "kind": "string",
      "term": "string",
      "replacement": "string",
      "app": "string"
    },
    "TypingCapture": {
      "kind": "string",
      "text": "string",
      "overused": "bool",
      "target": "bool",
      "app": "string"
    }
  },
  "names": [
    {
      "source": "typingStatus",
      "live": true,
      "answers": "TypingStatus",
      "substitute": {
        "default": { "available": false, "trusted": false, "running": false, "words": 0, "underlines": false },
        "unsupported": ["web", "linux", "ios", "android", "tvos", "terminal"]
      }
    },
    {
      "send": "setTypingTable",
      "origin": "app",
      "options": { "table": "string" },
      "answers": "TypingStatus",
      "substitute": {
        "default": { "available": false, "trusted": false, "running": false, "words": 0, "underlines": false },
        "unsupported": ["web", "linux", "ios", "android", "tvos", "terminal"]
      }
    },
    {
      "send": "setUnderlines",
      "origin": "app",
      "options": { "on": "bool" },
      "answers": "TypingStatus",
      "substitute": {
        "default": { "available": false, "trusted": false, "running": false, "words": 0, "underlines": false },
        "unsupported": ["web", "linux", "ios", "android", "tvos", "terminal"]
      }
    },
    {
      "send": "openAccessibilitySettings",
      "origin": "app",
      "options": {},
      "answers": null,
      "substitute": {
        "journal": true,
        "unsupported": ["web", "linux", "ios", "android", "tvos", "terminal"]
      }
    },
    { "event": "typingmove", "on": "root", "raised": "emit", "args": ["TypingMove"], "hold": 64 },
    { "event": "typingcapture", "on": "root", "raised": "emit", "args": ["TypingCapture"], "hold": 16 }
  ]
}
