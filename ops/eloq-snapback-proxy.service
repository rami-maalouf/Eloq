[Unit]
Description=Eloq private bridge to the loopback backend
After=eloq-snapback.service
Requires=eloq-snapback-proxy.socket

[Service]
Type=notify
ExecStart=/lib/systemd/systemd-socket-proxyd --connections-max=256 127.0.0.1:4420
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=32M
CPUQuota=10%
