[Unit]
Description=Eloq Snapback 4 backend
After=network.target

[Service]
Type=simple
User=eloq
Group=eloq
WorkingDirectory=/var/lib/eloq
ExecStart=/opt/eloq/snapback4 serve /var/lib/eloq/deployment --bind 127.0.0.1 --port 4420
Restart=on-failure
SuccessExitStatus=143
RestartSec=5
TimeoutStopSec=45
MemoryMax=512M
CPUQuota=100%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eloq
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
